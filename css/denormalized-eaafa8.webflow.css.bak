.counter {
  color: #fff;
  /* WV-66 — match .swiper-btn exactly. This set only a colour, so the counter
     fell through to the browser default: Arial at a FIXED 14px, while the
     [Previous]/[Next] either side of it are Regesto at .875rem. The root font
     size here is 1.111vw, so those buttons grow with the viewport (14px at
     1440, ~18px at 1920) and the counter did not — which is why they read as
     different sizes. Same family, same rem, same leading. */
  font-family: Regestogrotesk, Arial, sans-serif;
  font-size: .875rem;
  font-weight: 400;
  line-height: 130%;
}

