@media screen and (max-width: 479px) {
  .header {
    height: auto;
  }

  .container {
    padding-left: 3.2vw;
    padding-right: 3.2vw;
  }

  .container.is-full-mob {
    padding-left: 0;
    padding-right: 0;
  }

  .container.is-footer {
    padding-left: 0;
    padding-right: 0;
  }

  .header-body {
    grid-column-gap: 62.6vw;
    grid-row-gap: 62.6vw;
    padding-top: 10.66vw;
    padding-bottom: 6.4vw;
    position: relative;
  }

  .header-nav_block {
    z-index: 9999;
    border-bottom: .27vw solid #0003;
    justify-content: space-between;
    align-items: center;
    position: relative;
  }

  .null-gap.is-hor {
    grid-column-gap: .533333vw;
    grid-row-gap: .533333vw;
  }

  .null-gap.is-hor.is-black {
    grid-column-gap: 1vw;
    grid-row-gap: 1vw;
  }

  .null-gap.is-hor.is-black.is-abs {
    position: absolute;
    inset: auto 0% 23vw auto;
  }

  .null-gap.is-left {
    display: none;
  }

  .null-gap.card-max {
    max-width: none;
  }

  .null-gap.is-min {
    z-index: 998;
    flex-flow: column;
    justify-content: flex-start;
    align-items: center;
    min-width: auto;
    display: flex;
    position: relative;
  }

  .text-small {
    font-size: 3.73vw;
  }

  .text-small.is-white.is-opac40 {
    display: none;
  }

  .text-small.is-white.is-first-mob {
    order: -9999;
  }

  .text-small.is-white.is-last-mob {
    order: 9999;
  }

  .text-small.is-white.is-mob-hide {
    display: none;
  }

  .text-small.is-white.is-desk-hide {
    align-self: flex-end;
    display: block;
  }

  .text-small.is-white.is-12px-mob.is-mob-black {
    color: #000;
  }

  .text-small.is-white.is-cases-max {
    max-width: 50vw;
  }

  .text-small.is-white.reveal-text.rt-white {
    color: #fff;
  }

  .text-small.is-grey.is-block {
    display: block;
  }

  .text-small.trigger-sound.is-12px-mob, .text-small.is-12px-mob {
    font-size: 3.2vw;
  }

  .text-small.is-12px-mob.reveal-text.is-left {
    align-self: flex-start;
    width: 100%;
    min-width: 93.6vw;
  }

  .text-small.reveal-text.is-mob-hide {
    display: none;
  }

  .text-small.is-white50 {
    color: #ffffff80;
  }

  .text-small.is-fix.is-state, .text-small.is-fix.is-move {
    height: 5vw;
    min-height: 5vw;
  }

  .text-small.is-color.is-mob-hide {
    display: none;
  }

  .text-small.is-desk-hide {
    justify-content: flex-end;
    align-items: center;
    padding-right: 13.4vw;
  }

  .text-small.is-desk-hide.is-color-text {
    color: #6b2138;
    display: flex;
  }

  .logo {
    width: 11.2vw;
    height: 11.2vw;
  }

  .logo.is-first-mob {
    z-index: 998;
    order: -9999;
    position: relative;
  }

  .logo.is-first-mob.w--current, .logo.is-first-mob.is-white {
    z-index: 998;
  }

  .logo.is-404 {
    width: 35vw;
  }

  .nav-blog-item {
    grid-column-gap: 2.13vw;
    grid-row-gap: 2.13vw;
    min-width: auto;
    max-width: 46.1333vw;
    position: absolute;
    inset: 24.2vw 3.2vw auto auto;
  }

  .nav-blog-text_wrapp {
    z-index: 9;
    display: none;
    position: relative;
  }

  .max-text_wrap {
    z-index: 1;
    max-width: 17.3333vw;
