@font-face {
  font-family: Regestogrotesk;
  src: url('../fonts/RegestoGrotesk-Medium.woff') format("woff");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: Regestogrotesk;
  src: url('../fonts/RegestoGrotesk-Regular.woff') format("woff");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: Hawk;
  src: url('../fonts/Hawk-Regular.ttf') format("truetype");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

body {
  color: #333;
  font-family: Arial, Helvetica Neue, Helvetica, sans-serif;
  font-size: 14px;
  line-height: 20px;
}

.site-wrap {
  overflow: clip;
}

.site-wrap.is-black {
  background-color: #000;
  min-height: 100vh;
}

.container {
  width: 100%;
  max-width: 100vw;
  height: 100%;
  margin-left: auto;
  margin-right: auto;
  padding-left: 2rem;
  padding-right: 2rem;
}

.container.is-footer {
  padding-right: 1.4375rem;
}

.container.is-full {
  padding-left: 0;
}

.header-body {
  grid-column-gap: 4.25rem;
  grid-row-gap: 4.25rem;
  flex-flow: column;
  justify-content: space-between;
  padding-top: 2rem;
  padding-bottom: 2rem;
  display: flex;
}

.header-nav_block {
  z-index: 2;
  justify-content: space-between;
  align-items: flex-start;
  width: 100%;
  display: flex;
  position: relative;
}

.null-gap.max-173 {
  text-align: right;
  max-width: 10.8125rem;
}

.null-gap.is-hor {
  justify-content: flex-start;
  align-items: center;
  text-decoration: none;
  display: flex;
}

.null-gap.is-hor.is-black {
  grid-column-gap: .125rem;
  grid-row-gap: .125rem;
  color: #fff;
}

.null-gap.is-left {
  flex-flow: column;
  justify-content: flex-start;
  align-items: flex-end;
  display: flex;
}

.null-gap.card-max {
  max-width: 21.25rem;
}

.null-gap.is-min {
  flex-flow: column;
  justify-content: flex-start;
  align-items: flex-start;
  min-width: 17.375rem;
  display: flex;
}

.text-small {
  color: #000;
  cursor: none;
  justify-content: flex-start;
  align-items: center;
  font-family: Regestogrotesk, Arial, sans-serif;
  font-size: .875rem;
  font-weight: 400;
  line-height: 130%;
  text-decoration: none;
  display: flex;
  position: relative;
  overflow: hidden;
}

.text-small.is-white-upper {
  color: #fff;
  text-transform: uppercase;
}

.text-small.is-white-upper.is-link {
  text-decoration: underline;
}

.text-small.is-white {
  color: #fff;
  justify-content: flex-start;
  align-items: center;
  line-height: 130%;
  display: flex;
  position: relative;
  overflow: hidden;
}

.text-small.is-white.is-opac50 {
  color: #ffffff80;
  line-height: 130%;
}

.text-small.is-white.is-opac45 {
  color: #ffffff73;
  text-transform: uppercase;
}

.text-small.is-white.is-opac40 {
  color: #fff6;
}

.text-small.is-white.is-desk-hide {
  display: none;
}

.text-small.is-white.is-cases-max {
  max-width: 19.25rem;
}

.text-small.is-grey {
  color: #aaa;
}

.text-small.trigger-sound {
  cursor: pointer;
}

.text-small.is-12px-mob.reveal-text, .text-small.reveal-text {
  display: block;
}

.text-small.is-opac50 {
  color: #00000080;
}

.text-small.is-white50 {
  color: #ffffff80;
}

.text-small.is-fix {
  height: 1rem;
  min-height: 1.3rem;
}

.text-small.is-fix-cases {
  min-width: 8.8125rem;
}

.text-small.is-color {
  color: #6b2138;
}

.text-small.is-desk-hide.is-color-text {
  display: none;
}

.text-small.is-vert {
  flex-flow: column;
  justify-content: flex-start;
  align-items: flex-start;
}

.logo {
  color: #000;
  cursor: none;
  justify-content: center;
  align-items: center;
  width: 9.75rem;
  height: 2.5625rem;
  display: flex;
}

.logo.is-first-mob.is-white, .logo.is-first-mob.is-white.w--current {
  color: #fff;
}

.potato_embed {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  display: flex;
}

.navigation-block {
  grid-column-gap: 20.75rem;
  grid-row-gap: 20.75rem;
  justify-content: flex-start;
  align-items: flex-start;
  display: flex;
}

.nav-blog-item {
  grid-column-gap: 1rem;
  grid-row-gap: 1rem;
  flex-flow: column;
  min-width: 17.313rem;
  max-width: 17.3125rem;
  text-decoration: none;
  display: flex;
}

.nav-blog-text_wrapp {
  grid-column-gap: 0rem;
  grid-row-gap: 0rem;
  justify-content: space-between;
  align-items: center;
  display: flex;
}

.max-text_wrap {
  max-width: 10.1875rem;
  position: relative;
}

.nav-blog-contant {
  flex-flow: column;
  justify-content: space-between;
  width: 17.3125rem;
  height: 9.125rem;
  padding: .4375rem .5rem .25rem;
  display: flex;
  position: absolute;
  inset: 0%;
}

.gap-between {
  justify-content: space-between;
  align-items: center;
  width: 100%;
  display: flex;
}

.icon-man {
  color: #000;
  width: 1.1875rem;
  height: 1.375rem;
}

.text-little {
  color: #000;
  font-family: Regestogrotesk, Arial, sans-serif;
  font-size: .625rem;
  font-weight: 400;
  line-height: .6875rem;
}

.blog-shape {
  border-radius: 50%;
  width: 7.25rem;
  min-width: 7.25rem;
  height: 7.25rem;
  position: absolute;
  inset: .75rem 0% auto 5.28rem;
  box-shadow: 2.4375rem 1.625rem 1.1875rem #00000008, 1.375rem .9375rem 1rem #00000017, .625rem .375rem .75rem #00000026, .125rem .125rem .375rem #0000002b;
}

.blog-shape.is-big {
  width: 13.25rem;
  min-width: 13.25rem;
  height: 13.25rem;
  position: static;
}

.blog-shape.is-hide {
  display: none;
}

.image {
  justify-content: center;
  align-items: center;
  width: 100%;
  max-width: none;
  height: 100%;
  min-height: 100%;
  display: flex;
}

.image.is-cover {
  object-fit: cover;
}

.image.is-mob, .image.is-nav-open {
  display: none;
}

.header-main-contant {
  grid-column-gap: 3rem;
  grid-row-gap: 3rem;
  flex-flow: column;
  display: flex;
}

.header-text_block {
  justify-content: flex-end;
  display: flex;
}

.header-text_wrap {
  grid-column-gap: 1rem;
  grid-row-gap: 1rem;
  flex-flow: column;
  max-width: 17.7rem;
  display: flex;
}

.new-line.is-block {
  display: block;
}

.header-navigation {
  z-index: 2;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  display: flex;
  position: relative;
}

.header-hed_block {
  grid-column-gap: .5rem;
  grid-row-gap: .5rem;
  flex-flow: column;
  justify-content: flex-start;
  align-items: center;
  display: flex;
}

.hed-1 {
  color: #000;
  letter-spacing: -.02em;
  text-transform: uppercase;
  margin-top: 0;
  margin-bottom: 0;
  font-family: Regestogrotesk, Arial, sans-serif;
  font-size: 11.1875rem;
  font-weight: 500;
  line-height: 90%;
}

.hed-1.is-white {
  color: #fff;
}

.hed-1.is-center {
  text-align: center;
}

.hed-1.is-center.is-vw, .hed-1.is-vw {
  font-size: 12.4306vw;
}

.is-decor-text {
  font-family: Hawk, Arial, sans-serif;
  font-weight: 400;
}

.header-abs {
  color: #000;
  width: 8.125rem;
  height: 8.125rem;
  margin-left: auto;
  margin-right: auto;
  position: absolute;
  inset: 17.3125rem 0% auto;
}

.section.is-relat-stiki {
  z-index: 10;
  position: relative;
}

.section.is-founder {
  background-image: url('../images/Frame-2085663530.png');
  background-position: 50%;
  background-size: cover;
  height: 57.43vw;
}

.section.is-tabs {
  background-image: url('../images/test2-1-1.png');
  background-position: 50%;
  background-size: auto;
  position: relative;
}

.section.is-cursor {
  min-height: 230rem;
  overflow: clip;
}

.section.is-test {
  background-color: #000;
  height: 100vh;
  position: sticky;
  top: 0;
}

.section.is-color {
  z-index: 10;
  height: 100vh;
  position: relative;
}

.section.is-full {
  height: 100vh;
}

.section.is-relat {
  position: relative;
}

.section.is-white {
  z-index: 2;
  background-color: #fff;
  position: relative;
}

.video-block {
  width: 90rem;
  height: 48.4375rem;
  margin-left: auto;
  margin-right: auto;
}

.cases-body {
  grid-column-gap: 3.9375rem;
  grid-row-gap: 3.9375rem;
  flex-flow: column;
  padding-top: 7rem;
  padding-bottom: 6.25rem;
  display: flex;
}

.cases-hed_block {
  grid-column-gap: 4.3125rem;
  grid-row-gap: 4.3125rem;
  grid-template-rows: auto;
  grid-template-columns: auto 1fr;
  grid-auto-columns: 1fr;
  display: grid;
}

.cases-text_block {
  grid-column-gap: 4.0625rem;
  grid-row-gap: 4.0625rem;
  flex-flow: column;
  justify-content: center;
  align-items: flex-start;
  width: 100%;
  min-width: 100%;
  display: flex;
}

.cases-item_contant {
  grid-column-gap: .5rem;
  grid-row-gap: .5rem;
  flex-flow: column;
  padding-left: 36.125rem;
  display: flex;
}

.cases-item {
  grid-column-gap: .75rem;
  grid-row-gap: .75rem;
  justify-content: space-between;
  align-items: center;
  display: flex;
}

.cases-item-text_wrap {
  text-align: right;
  max-width: 9.8125rem;
}

.cases-item-text_wrap.is-big {
  max-width: 20rem;
}

.hed-2 {
  color: #000;
  margin-top: 0;
  margin-bottom: 0;
  font-family: Regestogrotesk, Arial, sans-serif;
  font-size: 2.625rem;
  font-weight: 500;
  line-height: 90%;
}

.hed-2.is-opac {
  color: #0006;
  justify-content: flex-start;
  align-items: center;
  display: flex;
  position: relative;
  overflow: hidden;
}

.hed-2.is-upper {
  text-transform: uppercase;
}

.cases-main-item {
  grid-column-gap: 4.375rem;
  grid-row-gap: 4.375rem;
  cursor: none;
  grid-template-rows: auto;
  grid-template-columns: auto 1fr;
  grid-auto-columns: 1fr;
  text-decoration: none;
  display: grid;
}

.gap-small {
  grid-column-gap: .875rem;
  grid-row-gap: .875rem;
  flex-flow: column;
  justify-content: flex-start;
  align-items: flex-start;
  display: flex;
}

.gap-small.is-cases {
  width: 31.8125rem;
  max-width: 31.8125rem;
  padding-right: 11rem;
}

.cases-logo {
  width: 4.5625rem;
  height: 1.4375rem;
}

.cases-image {
  width: 100%;
  min-width: 100%;
  min-height: 25rem;
}

.mouse-move {
  z-index: 10;
  justify-content: center;
  align-items: center;
  width: 4.3125rem;
  min-width: 4.312rem;
  height: 5.4375rem;
  display: flex;
}

.cursor-wrapper {
  z-index: 99999;
  justify-content: center;
  align-items: center;
  display: flex;
  position: fixed;
  inset: 0%;
}

.text-back_wrap {
  justify-content: flex-start;
  align-items: flex-start;
  margin-left: 36.125rem;
  display: flex;
}

.text-body {
  flex-flow: column;
  justify-content: flex-start;
  align-items: flex-start;
  padding-top: 7.6875rem;
  padding-bottom: 39rem;
  display: flex;
}

.text-overlay-block {
  color: #000;
  margin-top: 4.375rem;
  display: flex;
  position: relative;
}

.hed-3 {
  color: #000;
  text-align: justify;
  margin-top: 0;
  margin-bottom: 0;
  font-family: Regestogrotesk, Arial, sans-serif;
  font-size: 4.5rem;
  font-weight: 500;
  line-height: 95%;
}

.hed-3.is-left {
  text-align: left;
  text-indent: 0;
  line-height: 100%;
}

.hed-3.is-left.reveal-text {
  line-height: 90%;
}

.hed-3.is-white {
  color: #fff;
  text-align: left;
  text-indent: 0%;
}

.hed-3.is-white.is-center {
  text-align: center;
}

.hed-3.no-letter {
  text-align: left;
  text-indent: 0;
}

.hed-3.no-letter.reveal-text, .hed-3.is-fix {
  line-height: 120%;
}

.overlay-abs {
  cursor: pointer;
  justify-content: center;
  align-items: center;
  height: 2.4375rem;
  display: flex;
  position: absolute;
  inset: 0% 0% auto auto;
  overflow: hidden;
}

.overlay-abs.is-1 {
  width: 41.8125rem;
  height: 2.9375rem;
  min-height: 2.9375rem;
  display: none;
  top: 5.1875rem;
  right: .5rem;
}

.overlay-abs.is-2 {
  width: 9.75rem;
  inset: 5.3125rem auto auto 0%;
}

.overlay-abs.is-3 {
  width: 25.375rem;
  height: 2.9375rem;
  display: none;
  inset: 17.375rem 0% auto auto;
}

.overlay-abs.is-4 {
  width: 9.9375rem;
  inset: auto auto 8.5rem 24.5625rem;
}

.overlay-abs.is-5 {
  width: 31.4375rem;
  inset: auto auto 4.4375rem .25rem;
}

.overlay-abs.is-6 {
  width: 18.5rem;
  height: 2.9375rem;
  display: none;
  inset: auto auto 16.3125rem 0%;
}

.is-x2 {
  font-size: 2.7rem;
}

.founder-body {
  flex-flow: column;
  justify-content: space-between;
  height: 100%;
  padding-top: 2.625rem;
  padding-bottom: 2rem;
  display: flex;
}

.founder-contant {
  grid-column-gap: 1.5rem;
  grid-row-gap: 1.5rem;
  flex-flow: column;
  justify-content: flex-start;
  align-items: flex-end;
  padding-top: 1.875rem;
  display: flex;
}

.founder-contant-item {
  grid-column-gap: .6875rem;
  grid-row-gap: .6875rem;
  justify-content: flex-start;
  align-items: flex-start;
  display: flex;
}

.founder-contant-item.is-2 {
  grid-column-gap: 12.0625rem;
  grid-row-gap: 12.0625rem;
  margin-right: 4.6875rem;
}

.founder-text_wrap {
  max-width: 17.3125rem;
}

.gap-little {
  grid-column-gap: .75rem;
  grid-row-gap: .75rem;
  justify-content: flex-start;
  align-items: center;
  display: flex;
}

.gap-little.is-vert {
  grid-column-gap: .625rem;
  grid-row-gap: .625rem;
  flex-flow: column;
}

.gap-little.is-fix {
  justify-content: flex-end;
  align-items: center;
  min-width: 17.3125rem;
}

.founder-hed_block {
  flex-flow: row;
  justify-content: space-between;
  align-items: center;
  display: flex;
  position: relative;
}

.hed-decor {
  color: #fff;
  font-family: Regestogrotesk, Arial, sans-serif;
  font-size: 11.25rem;
  font-weight: 400;
  line-height: 90%;
}

.foun-hed_wrap {
  flex-flow: column;
  justify-content: flex-start;
  align-items: flex-end;
  display: flex;
}

.tabs-body {
  z-index: 2;
  flex-flow: column;
  justify-content: space-between;
  align-items: stretch;
  height: 100%;
  padding-top: 1.5rem;
  padding-bottom: 1.5rem;
  display: flex;
  position: relative;
}

.cursor-style {
  display: none;
}

.progressive-blur {
  height: 100vh;
  min-height: 100vh;
  position: sticky;
  top: 0;
}

.mouse-dot {
  justify-content: center;
  align-items: center;
  width: 8px;
  min-width: 8px;
  height: 8px;
  display: flex;
}

.tabs-item_wrap {
  justify-content: space-between;
  align-items: center;
  display: flex;
}

.tabs-item {
  grid-column-gap: .75rem;
  grid-row-gap: .75rem;
  flex-flow: column;
  display: flex;
}

.tabs-number {
  color: #fff;
  font-family: Regestogrotesk, Arial, sans-serif;
  font-size: 2.625rem;
  font-weight: 400;
  line-height: 90%;
}

.tabs-number.is-center {
  align-self: center;
}

.tabs-number.is-right {
  align-self: flex-end;
}

.tabs-card-wrap {
  z-index: 3;
  justify-content: center;
  align-items: center;
  display: flex;
  position: relative;
}

.tabs-card {
  background-color: #fff;
  flex-flow: column;
  justify-content: space-between;
  align-items: stretch;
  min-width: 49.875rem;
  max-width: 49.875rem;
  min-height: 28.875rem;
  max-height: 28.875rem;
  padding: 1.5rem;
  display: flex;
  position: absolute;
}

.tabs-card.id-4 {
  grid-column-gap: .75rem;
  grid-row-gap: .75rem;
  background-color: #fff0;
  flex-flow: row;
  min-width: auto;
  max-width: none;
  padding: 0;
}

.tabs-card.is-5 {
  background-color: #fff0;
  flex-flow: row;
  justify-content: space-between;
  align-items: stretch;
  padding: 0;
  display: none;
}

.tabs-card.is-6 {
  grid-column-gap: .75rem;
  grid-row-gap: .75rem;
  background-color: #fff0;
  flex-flow: row;
  min-width: auto;
  max-width: none;
  padding: 0;
}

.slider-body {
  grid-column-gap: 16px;
  grid-row-gap: 16px;
  grid-template-rows: auto auto;
  grid-template-columns: 1fr 1fr;
  grid-auto-columns: 1fr;
  max-width: 100%;
  height: 100%;
  padding-left: 2rem;
  padding-right: 2rem;
  position: relative;
}

.slider-body.no-pad {
  max-width: 96.5vw;
  min-height: 38.25rem;
  margin-left: auto;
  margin-right: auto;
  padding-left: 0;
  padding-right: 0;
}

.slider-hed-contant {
  width: 50%;
  height: 100%;
}

.slider-hed_body {
  flex-flow: column;
  justify-content: space-between;
  align-items: stretch;
  height: 100%;
  padding-top: 3.125rem;
  padding-bottom: 3.125rem;
  padding-right: 10rem;
  display: flex;
}

.swiper {
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

.swiper.is-cases-main {
  width: 42.625rem;
  height: 38.25rem;
  position: absolute;
  inset: 0% auto auto 0%;
}

.swiper.is-cases-main.no-abs {
  width: 28.0625rem;
  height: auto;
  position: relative;
}

.swiper.is-cases-main.is-right {
  inset: 0% 0% auto auto;
}

.swiper.is-linen {
  width: 96.5vw;
  height: auto;
}

.swiper.is-custom {
  height: auto;
  overflow: visible;
}

.swiper-wrapper {
  width: 100%;
  height: 100%;
  display: flex;
}

.swiper-slide {
  cursor: none;
  width: 100%;
  min-width: 100%;
  height: 100%;
}

.swiper-slide.is-cases-main {
  width: 43rem;
  height: 100%;
  min-height: 38.25rem;
}

.swiper-slide.is-cases-main.no-abs {
  background-color: #f9f7f3;
  width: 28.0625rem;
  min-height: auto;
}

.swiper-slide.is-custom {
  width: 14.125rem;
  min-width: 14.125rem;
  height: 18.8125rem;
}

.gap-middle {
  grid-column-gap: 1.25rem;
  grid-row-gap: 1.25rem;
  flex-flow: column;
  display: flex;
}

.form-hed_block {
  grid-column-gap: .5rem;
  grid-row-gap: .5rem;
  display: flex;
}

.form-hed_block.is-right {
  grid-column-gap: 1rem;
  grid-row-gap: 1rem;
  justify-content: flex-end;
  align-items: center;
}

.form-block {
  margin-bottom: 0;
}

.form {
  display: flex;
}

.sbmt-btn {
  color: #000;
  cursor: none;
  background-color: #b5cadb00;
  padding: 0 .5rem;
  font-family: Regestogrotesk, Arial, sans-serif;
  font-size: .875rem;
  font-weight: 400;
  line-height: 130%;
}

.text-field {
  color: #aaa;
  border: 1px #000;
  border-bottom: .0625rem solid #0003;
  border-radius: 0;
  min-width: 9.8125rem;
  max-width: 9.8125rem;
  height: 1.375rem;
